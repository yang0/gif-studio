{
  "version": 1,
  "tts": {
    "name": "edge-tts",
    "timeout_seconds": 600,
    "argv": [
      "{python}",
      "{skill_dir}/voice_production.py",
      "--script",
      "{script_file}",
      "--out",
      "{audio_out}",
      "--voice",
      "zh-CN-XiaoxiaoNeural"
    ]
  },
  "alignment": {
    "name": "stable-ts:base:zh",
    "timeout_seconds": 1200,
    "argv": [
      "{python}",
      "{skill_dir}/forced_align.py",
      "--script",
      "{script_file}",
      "--audio",
      "{audio_file}",
      "--out",
      "{timeline_out}",
      "--model",
      "base",
      "--language",
      "zh"
    ]
  }
}
