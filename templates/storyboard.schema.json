{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gif-studio storyboard",
  "type": "object",
  "required": [
    "project_title",
    "width",
    "height",
    "fps",
    "shots"
  ],
  "properties": {
    "project_title": {
      "type": "string",
      "minLength": 1
    },
    "width": {
      "type": "integer",
      "minimum": 2
    },
    "height": {
      "type": "integer",
      "minimum": 2
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration_sec",
          "narration",
          "visual_goal",
          "visual_mode",
          "motion_plan"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "duration_sec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "narration": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "visual_goal": {
            "type": "string",
            "minLength": 1
          },
          "visual_mode": {
            "enum": [
              "visual_metaphor",
              "structure_relation",
              "mechanism_breakdown",
              "compare_contrast",
              "data_motion"
            ]
          },
          "background": {
            "type": "string"
          },
          "accent_colors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "motion_plan": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "subtitle_cues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start_sec",
                "end_sec",
                "text"
              ],
              "properties": {
                "start_sec": {
                  "type": "number",
                  "minimum": 0
                },
                "end_sec": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "text": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "style_id": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
