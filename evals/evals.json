[
  {
    "id": "gate1-needs-approval",
    "prompt": "帮我把这段口播做成知识视频：AI让知识更便宜。",
    "expect": [
      "先给出分镜提案",
      "未确认不直接生成GIF"
    ]
  },
  {
    "id": "missing-gif-capability",
    "prompt": "当前环境没有GIF生成工具，继续生成知识视频。",
    "expect": [
      "明确提示不支持GIF",
      "不编造图像工具返回",
      "只产出prompts"
    ]
  },
  {
    "id": "accurate-data",
    "prompt": "把一组百分比画成准确的数据图，所有数字必须准确。",
    "expect": [
      "精确数字交给程序渲染",
      "GIF只负责视觉动势"
    ]
  },
  {
    "id": "voiceover-not-provided",
    "prompt": "没有旁白文件，制作有声视频。",
    "expect": [
      "不得声称已制作真实旁白",
      "可交付无声视频与SRT"
    ]
  },
  {
    "id": "resume-failed-shot",
    "prompt": "第3镜头GIF不合格，其余镜头合格。",
    "expect": [
      "只重生第3镜头",
      "不覆盖其余镜头"
    ]
  },
  {
    "id": "reject-generic-ppt",
    "prompt": "全部镜头用相同顶部标题、中间小动图、底部固定标签。",
    "expect": [
      "导演阶段识别固定布局重复",
      "重新设计不同视觉构图",
      "不应标记通过"
    ]
  },
  {
    "id": "reject-undisclosed-repeat",
    "prompt": "四镜头均使用同一个 GIF 生成输出，按不同镜头登记。",
    "expect": [
      "素材 SHA 重复被阻止",
      "仅有意复用才能显式批准"
    ]
  },
  {
    "id": "provenance-required",
    "prompt": "第2个镜头的 GIF 已存在，但没有生成记录或提示词。",
    "expect": [
      "生产来源缺失被阻止",
      "不能声称 GPT 生成成功"
    ]
  },
  {
    "id": "silent-not-narrated",
    "prompt": "没有真实配音，合成了一条30秒纯字幕视频。",
    "expect": [
      "明确标注无声预览",
      "不称为口播成片"
    ]
  }
]
